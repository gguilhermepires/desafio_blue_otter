# Kubernetes Secrets Template
# Use this to create secrets for Kubernetes deployment

# ===== PostgreSQL =====
POSTGRES_PASSWORD=changeme_secure_password_here
DATABASE_URL=postgresql://postgres:changeme_secure_password_here@postgres:5432/github_repos

# ===== API Secrets =====
GITHUB_TOKEN=  # Optional: Your GitHub Personal Access Token for higher rate limits
DB_PASSWORD=changeme_secure_password_here  # Must match POSTGRES_PASSWORD

# ===== Grafana =====
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_secure_password_here

# ===== DigitalOcean =====
DO_TOKEN=your-digitalocean-api-token-here

# ===== Container Registry =====
# Option 1: DigitalOcean Container Registry
CONTAINER_REGISTRY=registry.digitalocean.com/your-registry-name

# Option 2: DockerHub
# CONTAINER_REGISTRY=docker.io/your-dockerhub-username

# ===== Instructions =====
# 1. Copy this file: cp .env.k8s.example .env.k8s
# 2. Fill in all values above
# 3. Generate base64 encoded secrets:
#    echo -n 'your-password' | base64
# 4. Update kubernetes/01-secrets.yaml with encoded values
# 5. Or create secrets directly:
#    kubectl create secret generic postgres-secret \
#      --from-literal=POSTGRES_PASSWORD='your-password' \
#      --from-literal=DATABASE_URL='postgresql://...' \
#      -n github-api-dev
